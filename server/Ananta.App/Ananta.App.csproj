<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AnantaTestGameServer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ananta.Core\Ananta.Core.csproj" />
    <ProjectReference Include="..\Ananta.Network\Ananta.Network.csproj" />
    <ProjectReference Include="..\Ananta.Handlers\Ananta.Handlers.csproj" />
    <ProjectReference Include="..\Ananta.Gameplay\Ananta.Gameplay.csproj" />
    <ProjectReference Include="..\Ananta.RpcTypes\Ananta.RpcTypes.csproj" />
    <ProjectReference Include="..\Ananta.GmUi\Ananta.GmUi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="configs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\vehicle_names.csv" Condition="Exists('..\..\vehicle_names.csv')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\officialpcap.txt" Condition="Exists('..\..\officialpcap.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\officialpcap2.txt" Condition="Exists('..\..\officialpcap2.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
