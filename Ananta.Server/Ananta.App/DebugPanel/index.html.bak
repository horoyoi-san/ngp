async function pushTime() {
  const total = num($('timeSlider').value, 720);
  const r = await post('/api/time/set', { hour: Math.floor(total / 60) % 24, minute: total % 60, fix: true, transition: 5 });
  log('时间设置为 ' + fmtClock(total) + ' => ' + JSON.stringify(r));
}
function setQuickTime(h, m) {
  $('timeSlider').value = h * 60 + m;
  $('clock').textContent = fmtClock(h * 60 + m);
  pushTime();
}
$('timeSlider').addEventListener('input', (e) => {
  state.timeDragging = true;
  $('clock').textContent = fmtClock(num(e.target.value, 720));
});
$('timeSlider').addEventListener('change', () => { state.timeDragging = false; pushTime(); });

/* ============================ 传送 ============================ */
function fillCurrent() {
  if (!state.status || !state.status.online) return;
  const p = state.status.player;
  $('tx').value = fmt(p.x); $('ty').value = fmt(p.y); $('tz').value = fmt(p.z); $('tf').value = fmt(p.yaw);
}
function fillSpawn() {
  if (!state.status || !state.status.online || !state.status.spawn) return;
  $('tx').value = state.status.spawn.x; $('ty').value = state.status.spawn.y; $('tz').value = state.status.spawn.z;
}
async function teleport() {
  await call('/api/player/teleport', {
    x: num($('tx').value), y: num($('ty').value), z: num($('tz').value), facing: num($('tf').value),
  }, '已传送');
}

/* ================ 跨场景与副本切换（参考 PrivateServer2） ================ */
function srApplySpot(sel) {
  const v = (sel.value || '').split(',');
  if (v.length !== 3) return;
  $('srX').value = v[0];
  $('srY').value = v[1];
  $('srZ').value = v[2];
}
function srFillCurrent() {
  if (!state.status || !state.status.online || !state.status.player) {
    snack('客户端不在游戏中，拿不到当前位置', 'error'); return;
  }
  const p = state.status.player;
  $('srX').value = fmt(p.x); $('srY').value = fmt(p.y); $('srZ').value = fmt(p.z);
  $('srFacing').value = fmt(p.yaw);
}
async function switchRaid() {
  const body = {
    raidId: num($('srRaid').value),
    sceneInstanceId: num($('srInst').value),
    universeId: num($('srUni').value),
    x: num($('srX').value),
    y: num($('srY').value),
    z: num($('srZ').value),
    facing: num($('srFacing').value),
  };
  if (!body.raidId || !body.sceneInstanceId || !body.universeId) {
    snack('raidId + sceneInstanceId + universeId 都必填', 'error'); return;
  }
  const r = await post('/api/world/switch-raid', body);
  log(' 场景切换 => ' + JSON.stringify(r));
  if (r.ok === false) { snack(r.error, 'error'); return; }
  snack('已切到 raid ' + r.raidId + ' / scene ' + r.sceneInstanceId, 'ok');
  if ($('wrInfo')) $('wrInfo').textContent = r.note || '';
  await refreshAll();
}
async function switchBack() {
  $('srRaid').value = 23300888;
  $('srInst').value = 20001222;
  $('srUni').value = 76000888;
  $('srX').value = 3142.7;
  $('srY').value = 0;
  $('srZ').value = 2522.8;
  $('srFacing').value = 0;
  await switchRaid();
}
async function loadWorldOptions() {
  try {
    const r = await api('/api/world/options');
    const raids = (r && r.raids) || [];
    log('可用 Raid 共 ' + raids.length + ' 个: ' + raids.slice(0, 12).map((x) => x.id + '=' + x.name).join(', ') + ' …');
    if ($('wrInfo')) $('wrInfo').textContent = '可用 Raid ' + raids.length + ' 个（详见日志）：'
      + raids.filter((x) => /新启|重霄|凌云/.test(x.name || '')).map((x) => x.id + '=' + x.name).join(' · ');
  } catch (e) { log('世界选项加载失败: ' + e, 'err'); }
}

/* ============================ 载具 ============================ */
async function loadFleet() {
  try {
    state.fleet = await api('/api/fleet');
    if (!Array.isArray(state.fleet)) state.fleet = [];
    const cats = [...new Set(state.fleet.map((v) => v.cat))];
    $('fleetCat').innerHTML = cats.map((c) => '<option value="' + c + '">' + (CAT_NAMES[c] || c) + '</option>').join('');
    filterFleet();
  } catch (e) { log('载具目录加载失败: ' + e, 'err'); }
}
function filterFleet() {
  const c = $('fleetCat').value;
  const list = state.fleet.filter((v) => v.cat === c);
  $('fleet').innerHTML = list.map((v) => '<option value="' + v.id + '">' + v.id + ' — ' + esc(v.name || '') + '</option>').join('')
    || '<option value="">（该分类为空）</option>';
}
async function spawnNear() {
  const id = parseInt($('fleet').value || '0', 10);
  if (!id) return snack('请先选择载具', 'error');
  await call('/api/vehicle/spawn', { configId: id, distance: num($('fleetDist').value, 6) }, '载具已召唤');
}
async function spawnRaw() {
  const id = parseInt($('rawId').value || '0', 10);
  if (!id) return snack('请输入载具 ID', 'error');
  await call('/api/vehicle/spawn', { configId: id, distance: num($('fleetDist').value, 6) }, '载具已召唤');
}
async function enterLast() { await call('/api/vehicle/enter', {}); }
async function resync() { const r = await post('/api/garage/resync'); log('同步已验证车辆 ' + JSON.stringify(r)); snack('车库已同步', 'ok'); }
async function unlockAll() { const r = await post('/api/garage/unlock-all'); log('解锁全部车辆 ' + JSON.stringify(r)); snack('已解锁全部车辆', 'ok'); }
async function vehicleEnter(id) { await call('/api/vehicle/enter', { entityId: id }); }
async function vehicleExit() { await call('/api/vehicle/exit', {}); }
async function vehicleToMe(id) { await call('/api/vehicle/to-me', { entityId: id }, '载具已拉到身边'); }
async function vehicleGoto(id) { await call('/api/vehicle/goto', { entityId: id }, '已传送到载具旁'); }
async function vehicleRemove(id) { await call('/api/vehicle/remove', { entityId: id }, '载具已移除'); }

