const itemRows = () => state.dict.items || [];
function renderItemOptions() {
  const kw = $('itemSearch').value.trim().toLowerCase();
  const rows = itemRows().filter((r) => !kw
    || String(r.id).includes(kw)
    || String(r.zh || '').toLowerCase().includes(kw)
    || String(r.en || '').toLowerCase().includes(kw)).slice(0, 300);
  $('itemSelect').innerHTML = rows.map((r) => '<option value="' + r.id + '">' + r.id + ' — ' + esc(label(r.zh, r.en)) + '</option>').join('')
    || '<option value="">（无匹配）</option>';
