/* ============================ 任务（全部走 TaskConfig 机制） ============================ */
let taskHits = [];
async function loadTaskSearch() {
  const kw = ($('questSearch').value || '').trim();
  try {
    const r = await api('/api/tasks/search?limit=300' + (kw ? '&q=' + encodeURIComponent(kw) : ''));
    taskHits = (r && r.tasks) || [];
  } catch (e) { taskHits = []; }
  $('questSelect').innerHTML = taskHits.map((t) =>
    '<option value="' + t.id + '">' + t.id + ' — ' + esc(t.name || '') + '（目标 ' + t.counters + '）</option>').join('')
    || '<option value="">（无匹配）</option>';
  onQuestPick();
}
function pickedQuestId() { return parseInt($('questSelect').value || '0', 10); }
function currentTaskId() { return (state.story && state.story.currentTask) || 0; }
function onQuestPick() {
  const id = pickedQuestId();
  const t = taskHits.find((x) => x.id === id);
  $('questSelInfo').textContent = t ? (t.id + ' · ' + t.name + ' · 目标 ' + t.counters + ' 个') : '未选择';
}
async function questAccept() {
  const id = pickedQuestId();
  if (!id) return snack('请选择任务', 'error');
  const r = await call('/api/quest/accept', { taskId: id }, '任务已接取');
  if (r && r.message) log('接取 => ' + r.message);
  await loadStory();
}
async function questSubmit() {
  const id = pickedQuestId();
  if (!id) return snack('请选择任务', 'error');
  const r = await call('/api/quest/submit', { taskId: id }, '已标记为已提交');
  if (r && r.message) log('提交 => ' + r.message);
  await loadStory();
}
async function questComplete(id) {
  id = id || pickedQuestId();
  if (!id) return snack('没有可完成的任务', 'error');
  const r = await call('/api/quest/complete', { taskId: id }, '任务已完成并推进');
  if (r && r.message) log('完成 => ' + r.message);
  await loadStory();
}

/* ============================ 主线剧情链 + 真实容器 ============================ */
async function loadStory() {
  try {
    const r = await api('/api/story/chain');
    if (!r || !r.ok) return;
    state.story = r;
    $('storyRoot').textContent = r.root + (r.rootName ? ' · ' + r.rootName : '');
    $('storyLen').textContent = r.length + ' 步';

    // 真实容器（来自 GameRouter，不是面板镜像）
    const cur = r.currentTask || 0;
    $('qCurrent').textContent = cur || '无';
    $('qCurrentName').textContent = cur ? (r.currentTaskName || ('ID ' + cur)) : '—';
    const tasks = r.tasks || [];
    $('qCount').textContent = tasks.length;
    $('qHint').textContent = r.hasSession
      ? ('会话中 · 容器 ' + tasks.length + ' 条')
      : '未进世界（客户端没连上时容器为空）';
    $('qContainerTable').innerHTML = tasks.length === 0
      ? '<tbody><tr><td class="empty">容器为空 —— 进世界后服务端会自动灌入主线链首</td></tr></tbody>'
      : '<thead><tr><th>任务 ID</th><th>名称</th><th>状态</th><th>目标进度</th></tr></thead><tbody>'
        + tasks.map((t) => '<tr><td class="id">' + t.id + '</td><td>' + esc(t.name || '') + '</td>'
            + '<td>' + t.state + (t.state === (cur && (tasks.find(x => x.id === cur) || {}).state) ? '' : '') + '</td>'
            + '<td>' + (t.counters ? ((t.values || []).join('/') + ' / ' + t.counters) : '—') + '</td></tr>').join('')
        + '</tbody>';
  } catch (e) { /* 忽略：服务端没起来时静默 */ }
}
async function storyStart() {
  const r = await call('/api/story/start', {}, '主线已启动');
  if (r && r.message) log('主线 => ' + r.message);
}
async function storyAdvance() {
  const id = currentTaskId();
  if (!id) return snack('当前没有进行中的任务', 'error');
  const r = await call('/api/story/advance', { taskId: id }, '已推进');
  if (r && r.message) log('推进 => ' + r.message);
}
async function questReset() {
  const r = await call('/api/quest/reset', {}, '任务容器已重置');
  if (r && r.message) log('重置 => ' + r.message);
}
async function taskContainerHex() {
  const r = await api('/api/debug/task-container-hex');
  log('任务容器 ' + JSON.stringify({ taskId: r.taskId, name: r.name, counters: r.counters, size: r.size }));
  snack('容器 ' + r.size + ' 字节，已输出到日志', 'ok');
}

/* ============================ 敌人生成 ============================ */
let enemyGroups = [];
async function loadEnemyGroups() {
  try {
    const r = await api('/api/enemy/groups');
    enemyGroups = (r && r.groups) || [];
    renderEnemyOptions();
    log('敌人组 ' + enemyGroups.length + ' 个');
  } catch (e) { /* 忽略 */ }
}
function renderEnemyOptions() {
  const kw = ($('enemySearch').value || '').trim().toLowerCase();
  const rows = enemyGroups.filter((g) => !kw
    || String(g.id).includes(kw) || (g.name || '').toLowerCase().includes(kw));
  $('enemySelect').innerHTML = rows.map((g) =>
    '<option value="' + g.id + '">' + g.id + ' — ' + esc(g.name) + '（' + g.members + '）</option>').join('')
    || '<option value="">没有匹配的敌人组</option>';
  onEnemyPick();
}
function pickedEnemyId() { return parseInt($('enemySelect').value || '0', 10); }
function onEnemyPick() {
  const id = pickedEnemyId();
  const g = enemyGroups.find((x) => x.id === id);
  $('enemySelInfo').textContent = g ? (g.id + ' · ' + g.name + ' · 成员 ' + g.members) : '未选择';
}
async function enemySpawnGroup() {
  const id = pickedEnemyId();
  if (!id) return snack('请选择敌人组', 'error');
  const body = {
    groupId: id,
    campId: parseInt($('enemyCamp').value || '0', 10) || 0,
    members: parseInt($('enemyMembers').value || '0', 10) || 0,
  };
  const r = await call('/api/enemy/spawn-group', body, '敌人组已激活');
  if (r && r.message) log('敌人组 => ' + r.message);
}

let agents = [];
async function loadAgents() {
  const kw = ($('agentSearch').value || '').trim();
  const monsters = $('agentMonsters').value;
  try {
    const r = await api('/api/npc/agents?limit=200&monsters=' + monsters + (kw ? '&q=' + encodeURIComponent(kw) : ''));
    agents = (r && r.agents) || [];
    $('agentSelect').innerHTML = agents.map((a) =>
      '<option value="' + a.id + '">' + a.id + ' — ' + esc(a.name) + '</option>').join('')
      || '<option value="">没有匹配的 Agent</option>';
    onAgentPick();
  } catch (e) { /* 忽略 */ }
}
function pickedAgentId() { return parseInt($('agentSelect').value || '0', 10); }
function onAgentPick() {
  const a = agents.find((x) => x.id === pickedAgentId());
  $('agentSelInfo').textContent = a ? (a.id + ' · ' + a.name + ' · 怪物=' + a.monster) : '未选择';
}
async function npcSpawn() {
  const id = pickedAgentId();
  if (!id) return snack('请选择 Agent', 'error');
  const r = await call('/api/npc/spawn', { templateId: id, distance: 4 }, '已生成 NPC');
  if (r && r.message) log('NPC => ' + r.message);
}
async function enemySpawn() {
  const id = pickedAgentId();
  if (!id) return snack('请选择 Agent', 'error');
  const r = await call('/api/enemy/spawn', { templateId: id, count: 3, distance: 6 }, '已生成敌人');
  if (r && r.message) log('敌人 => ' + r.message);
}
async function ammoGive() {
  const r = await call('/api/ammo/give', { count: 999 }, '弹药已补齐');
  if (r && r.message) log('弹药 => ' + r.message);
}

/* ============================ 放置 NPC（写入存档） ============================ */
let streetNpcs = [];
/// 在**玩家当前位置**放置店员（参考 PrivateServer2 的「<svg viewBox="0 0 24 24" fill="currentColor" style="width:15px;height:15px"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg> 在当前位置放置店员」）。
/// 与"放置到玩家前方"的区别：这里直接把玩家实时坐标当落点，店员就站在你脚下。
async function placeNpcHere() {
  if (!state.status || !state.status.online || !state.status.player) {
    snack('客户端不在游戏中，拿不到当前位置', 'error'); return;
  }
  const p = state.status.player;
  const templateId = num($('placeTemplate').value) || num($('agentSelect') ? $('agentSelect').value : 0) || 15020990;
  const body = {
    templateId,
    name: ($('placeName') && $('placeName').value.trim()) || undefined,
    x: p.x, y: p.y, z: p.z, facing: p.yaw,
  };
  const r = await post('/api/npc/place', body);
  log('在当前位置放置店员 => ' + JSON.stringify(r));
  if (r.ok === false) { snack(r.error, 'error'); return; }
  snack('已放置店员', 'ok');
  if ($('placeName')) $('placeName').value = '';
  await loadStreetNpcs();
}

/// 恢复默认店员配置（清掉当前放置，再由服务端默认投放）。
async function resetDefaultNpcs() {
  if (!confirm('确定恢复默认店员配置吗？会先清空当前放置的 NPC。')) return;
  // 复用已有的清空全部放置
  await removeAllStreetNpcs();
  snack('已清空放置，重登后按默认配置投放', 'ok');
}

async function loadStreetNpcs() {
  try {
    const r = await api('/api/npc/street');
    streetNpcs = (r && r.npcs) || [];
  } catch (e) { streetNpcs = []; }
  $('streetNpcHint').textContent = '已放置 ' + streetNpcs.length + ' 个（存在账号存档里）';
  $('streetNpcTable').innerHTML = streetNpcs.length === 0
    ? '<tbody><tr><td class="empty">还没有放置任何 NPC</td></tr></tbody>'
    : '<thead><tr><th>ID</th><th>名称</th><th>模板</th><th>坐标</th><th>朝向</th><th>时装</th><th style="width:90px">操作</th></tr></thead><tbody>'
      + streetNpcs.map((n) => '<tr><td class="id">' + n.id + '</td><td>' + esc(n.name) + '</td>'
          + '<td class="id">' + n.templateId + '</td>'
          + '<td class="id">' + fmt(n.x) + ', ' + fmt(n.y) + ', ' + fmt(n.z) + '</td>'
          + '<td class="id">' + fmt(n.facing) + '</td>'
          + '<td class="id">' + ((n.fashions && n.fashions.length) ? n.fashions.join(',') : '默认') + '</td>'
          + '<td><button class="btn-danger btn-sm" onclick="removeStreetNpc(' + n.id + ')">移除</button></td></tr>').join('')
      + '</tbody>';
}
function placeTemplateId() {
  const typed = parseInt($('placeTemplate').value || '0', 10);
  return typed || pickedAgentId();
}
function placeFashionIds() {
  return ($('placeFashions').value || '').split(/[,，\s]+/)
    .map((s) => parseInt(s, 10)).filter((n) => Number.isFinite(n) && n > 0);
}
async function placeNpc() {
  const id = placeTemplateId();
  if (!id) return snack('请先选择 Agent 或填入模板 ID', 'error');
  const body = {
    templateId: id,
    distance: parseFloat($('placeDistance').value || '4') || 4,
    fashions: placeFashionIds(),
  };
  const r = await call('/api/npc/place', body, '已放置 NPC');
  if (r && r.message) log('放置 => ' + r.message);
  await loadStreetNpcs();
}
async function removeStreetNpc(id) {
  const r = await call('/api/npc/remove', { id: id }, '已移除');
  if (r && r.message) log('移除 => ' + r.message);
  await loadStreetNpcs();
}
async function removeAllStreetNpcs() {
  if (!confirm('会清空存档里所有放置的 NPC，确定？')) return;
  const r = await call('/api/npc/remove', { all: true }, '已清空');
  if (r && r.message) log('清空 => ' + r.message);
  await loadStreetNpcs();
}

/* ============================ 字典 ============================ */
async function loadDict(kind) {
  try {
    const data = await api('/api/dict/' + kind);
    if (Array.isArray(data)) state.dict[kind] = data;
    else if (data && data.counts) state.dictMeta = data;
    else state.dict[kind] = [];
  } catch (e) {
    log('字典 ' + kind + ' 加载失败: ' + e, 'err');
    state.dict[kind] = [];
  }
}
function renderDict() {
  const kind = $('dictKind').value;
  const kw = $('dictSearch').value.trim().toLowerCase();
  const all = state.dict[kind] || [];
  const rows = all.filter((r) => !kw || Object.values(r).some((v) => String(v == null ? '' : v).toLowerCase().includes(kw)));
  const cols = DICT_COLUMNS[kind] || [['ID', 'id']];
  const shown = rows.slice(0, 500);
  $('dictMeta').textContent = '共 ' + rows.length + ' 条' + (rows.length > shown.length ? '，显示前 ' + shown.length + ' 条' : '');
  $('dictTable').innerHTML = rows.length === 0
    ? '<tbody><tr><td class="empty">没有数据（字典可能未生成，或该类别为空）</td></tr></tbody>'
    : '<thead><tr>' + cols.map((c) => '<th>' + c[0] + '</th>').join('') + '</tr></thead><tbody>'
      + shown.map((r) => '<tr>' + cols.map((c, i) => '<td class="' + (i === 0 ? 'id' : '') + '">' + esc(r[c[1]]) + '</td>').join('') + '</tr>').join('')
      + '</tbody>';
}
async function copyDict() {
  const kind = $('dictKind').value;
  const rows = state.dict[kind] || [];
  const text = rows.map((r) => Object.values(r).join('\t')).join('\n');
  try { await navigator.clipboard.writeText(text); snack('已复制 ' + rows.length + ' 行', 'ok'); }
  catch (e) { snack('复制失败，请手动选择表格内容', 'error'); }
}

/* ============================ 功能修复 ============================ */
async function fixCall(path, okText) {
  const r = await post(path);
  log(path + ' => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error || '操作失败', 'error');
  else snack(okText + (r.count !== undefined ? '（' + r.count + '）' : '') + (r.entrances !== undefined ? '（传送点 ' + r.entrances + '）' : ''), 'ok');
  await refreshAll();
}
/* ======================== 基线单项重发 / Aether ======================== */
async function loadBaselineSteps() {
  try {
    const r = await api('/api/baseline/steps');
    const steps = (r && r.steps) || [];
    $('baselineStepBtns').innerHTML = steps.map((x) =>
      '<button class="btn-outlined btn-sm" onclick="baselinePush(\'' + x.key + '\')">' + esc(x.label) + '</button>'
    ).join('');
  } catch (e) { log('基线单项清单加载失败: ' + e, 'err'); }
}
async function baselinePush(key) {
  const r = await post('/api/baseline/push', { step: key });
  log('单项重发 ' + key + ' => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error');
  else snack(r.note || ('已重发 ' + key), 'ok');
}
async function aetherAtPlayer() {
  if (!state.status || !state.status.online || !state.status.player) {
    snack('客户端不在游戏中，拿不到当前位置', 'error'); return;
  }
  const p = state.status.player;
  const r = await post('/api/aether/spawnat', { x: p.x, y: p.y, z: p.z });
  log('/api/aether/spawnat => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error || '生成失败', 'error');
  else snack('已在当前位置生成 Aether', 'ok');
}

async function fixShop() {
  const id = parseInt($('fixShopId').value || '0', 10) || 0;
  const r = await post('/api/shop/open', { shopId: id });
  log('/api/shop/open => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack('货架已推送', 'ok');
}
async function pushZoneGraph() {
  const r = await post('/api/aether/zonegraph');
  log('/api/aether/zonegraph => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack(r.message || '已推送', 'ok');
}

async function fixTeleport() {
  const r = await post('/api/player/map-teleport', {
    x: num($('tpX').value), y: num($('tpY').value), z: num($('tpZ').value), facing: num($('tpF').value),
  });
  log('/api/player/map-teleport => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack('已下发传送', 'ok');
}

async function fixHouse() {
  const id = parseInt($('fixHouseId').value || '0', 10) || 0;
  const r = await post('/api/house/buy', { houseId: id });
  log('/api/house/buy => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack('房产已下发（ID ' + r.houseId + '）', 'ok');
}

/* ============================ 账号 ============================ */
async function refreshAccounts() {
  try {
    const r = await api('/api/accounts');
    state.accounts = r.accounts || [];
    state.accRoot = r.root || '';
    $('accRoot').textContent = '存档目录：' + state.accRoot;
    $('accTable').innerHTML = state.accounts.length === 0
      ? '<tbody><tr><td class="empty">没有账号</td></tr></tbody>'
      : '<thead><tr><th>ID</th><th>昵称</th><th>UID（账号 ID）</th><th>PID（角色 ID）</th><th>用户名</th><th>状态</th><th style="width:190px">操作</th></tr></thead><tbody>'
        + state.accounts.map((a) => '<tr><td class="id">' + esc(a.id) + '</td><td>' + esc(a.name) + '</td>'
            + '<td class="id">' + esc(a.uid) + '</td>'
            + '<td class="id">' + esc(a.pid) + '</td>'
            + '<td>' + esc(a.username) + '</td>'
            + '<td>' + (a.active ? '<span class="chip ok">当前</span>' : '') + '</td>'
            + '<td>' + (a.active ? '' : '<button class="btn-tonal btn-sm" onclick="accountSwitch(\'' + a.id + '\')">切换</button> ')
            + '<button class="btn-danger btn-sm" onclick="accountDelete(\'' + a.id + '\')">删除</button></td></tr>').join('')
        + '</tbody>';
  } catch (e) { log('账号读取失败: ' + e, 'err'); }
}
async function accountCreate() {
  const r = await post('/api/accounts/create', {
    id: $('accId').value.trim(), name: $('accName').value.trim(),
    username: $('accUser').value.trim(), password: $('accPass').value.trim(),
    uid: $('accUid').value.trim(), pid: parseInt($('accPid').value || '0', 10) || 0,
  });
  if (r.ok === false) return snack(r.error, 'error');
  $('accId').value = ''; $('accName').value = ''; $('accUser').value = ''; $('accPass').value = '';
  $('accUid').value = ''; $('accPid').value = '';
  await refreshAccounts();
  snack('账号已创建', 'ok');
}
async function accountSwitch(id) {
  const r = await post('/api/accounts/switch', { id });
  if (r.ok === false) return snack(r.error, 'error');
  await refreshAccounts();
  await refreshAll();
  snack('已切换到 ' + id + '（下次进游戏生效）', 'ok');
}
async function accountDelete(id) {
  if (!confirm('删除账号 ' + id + ' 及其全部存档？此操作不可恢复。')) return;
  const r = await post('/api/accounts/delete', { id });
  if (r.ok === false) return snack(r.error, 'error');
  await refreshAccounts();
  snack('已删除', 'ok');
}

async function weaponAddAll(currentOnly) {
  const r = await post('/api/weapon/add-all', { currentSpiritOnly: !!currentOnly });
  log('一键刷取武器 => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack('已刷取 ' + r.count + ' 件武器', 'ok');
  await refreshAll();
}
async function ammoAddAll() {
  const r = await post('/api/item/add-ammo');
  log('一键补齐弹药 => ' + JSON.stringify(r));
  if (r.ok === false) snack(r.error, 'error'); else snack('已补齐 ' + r.count + ' 种弹药', 'ok');
  await refreshAll();
}


/* ============================ 名称解析 ============================ */
function findIn(kind, key, val) {
  const rows = state.dict[kind] || [];
  return rows.find((r) => r[key] === val);
}
function spiritName(unitId) {
  const c = findIn('characters', 'unitId', unitId);
  return c ? (label(c.zh, c.en) + '（' + c.id + '）') : String(unitId);
}
function vehicleName(id) { const r = findIn('vehicles', 'id', id); return r ? label(r.zh, r.en) : ''; }
function itemName(id)    { const r = findIn('items', 'id', id);    return r ? label(r.zh, r.en) : ('ID ' + id); }
function weaponName(id)  { const r = findIn('weapons', 'id', id);  return r ? label(r.zh, r.en) : ('ID ' + id); }
function fashionName(id) { const r = findIn('fashions', 'id', id); return r ? label(r.zh, r.en) : ('ID ' + id); }
function taskName(id)    { const r = findIn('tasks', 'id', id);    return r ? label(r.zh, r.en) : ('ID ' + id); }

/* ============================ 渲染 ============================ */
function renderStatus() {
  const s = state.status;
  const online = !!(s && s.online);
  $('connDot').className = 'dot ' + (online ? 'on' : 'off');
  $('connText').textContent = online ? '客户端已连接' : '客户端未进入游戏';
  $('connChip').className = 'chip ' + (online ? 'ok' : 'bad');

  $('ovConn').textContent = online ? '已连接' : '离线';
  $('ovPid').textContent = online ? s.pid : '—';
  $('ovSpirit').textContent = online ? spiritName(s.activeUnit) : '—';
  $('ovReady').textContent = online ? (s.ready ? '就绪' : '加载中') : '—';
  $('ovPos').textContent = online ? (fmt(s.player.x) + ', ' + fmt(s.player.y) + ', ' + fmt(s.player.z)) : '—';
  $('ovYaw').textContent = online ? fmt(s.player.yaw) : '—';
  $('ovSummoned').textContent = online ? s.summoned.length : 0;
  $('ovSeat').textContent = (online && s.inVehicle) ? ('实体 ' + s.inVehicle + ' · 座位 ' + s.inSeat) : '不在车内';
  $('ovExitWrap').style.display = (online && s.inVehicle) ? '' : 'none';
  $('badgeGarage').textContent = online ? s.summoned.length : 0;

  if (online) {
    if (!state.timeDragging && typeof s.hour === 'number' && typeof s.minute === 'number' && s.hasTime) {
      $('timeSlider').value = s.hour * 60 + s.minute;
      $('clock').textContent = fmtClock(s.hour * 60 + s.minute);
    }
    $('timeSlider').disabled = false;
  } else {
    $('timeSlider').disabled = true;
  }

  const list = (online && s.summoned) ? s.summoned : [];
  $('summonedTable').innerHTML = list.length === 0
    ? '<tbody><tr><td class="empty">还没有载具，先在上方召唤一辆</td></tr></tbody>'
    : '<thead><tr><th>实体 ID</th><th>配置 ID</th><th>坐标</th><th style="width:340px">操作</th></tr></thead><tbody>'
      + list.map((v) => '<tr>'
          + '<td class="id">' + v.entityId + '</td>'
          + '<td class="id">' + v.configId + '<div class="name-en">' + esc(vehicleName(v.configId)) + '</div></td>'
          + '<td class="id">' + (v.hasFix ? (fmt(v.x) + ', ' + fmt(v.y) + ', ' + fmt(v.z)) : '—') + '</td>'
          + '<td><button class="btn-tonal btn-sm" onclick="vehicleEnter(' + v.entityId + ')">上车</button> '
          + '<button class="btn-outlined btn-sm" onclick="vehicleToMe(' + v.entityId + ')">拉到我身边</button> '
          + '<button class="btn-outlined btn-sm" onclick="vehicleGoto(' + v.entityId + ')">传送过去</button> '
          + '<button class="btn-danger btn-sm" onclick="vehicleRemove(' + v.entityId + ')">移除</button></td></tr>').join('')
      + '</tbody>';
}

function renderContent() {
  const c = state.content;
  if (!c) return;
  const bag = c.backpack || [], wp = c.weapons || [], fs = c.fashions || [];
  $('ovBagCount').textContent = bag.length;
  $('ovWeaponCount').textContent = wp.length;
  $('ovFashionCount').textContent = fs.length;
  $('ovMoney').textContent = (c.money || 0) + ' / ' + (c.gold || 0) + ' / ' + (c.bindingGold || 0);
  $('badgeItems').textContent = bag.length;
  $('badgeWeapons').textContent = wp.length;
  $('badgeFashions').textContent = fs.length;

  $('bagTable').innerHTML = bag.length === 0
    ? '<tbody><tr><td class="empty">背包为空</td></tr></tbody>'
    : '<thead><tr><th>物品 ID</th><th>名称</th><th>数量</th><th style="width:210px">操作</th></tr></thead><tbody>'
      + bag.map((b) => '<tr><td class="id">' + b.templateId + '</td><td>' + esc(itemName(b.templateId)) + '</td>'
          + '<td class="id">' + b.count + '</td><td>'
          + '<button class="btn-outlined btn-sm" onclick="itemRemove(' + b.templateId + ',0)">-1</button> '
          + '<button class="btn-danger btn-sm" onclick="itemRemove(' + b.templateId + ',1)">全部移除</button></td></tr>').join('')
      + '</tbody>';

  $('weaponTable').innerHTML = wp.length === 0
    ? '<tbody><tr><td class="empty">仓库为空</td></tr></tbody>'
    : '<thead><tr><th>实例 ID</th><th>武器模板</th><th>名称</th><th style="width:120px">操作</th></tr></thead><tbody>'
      + wp.map((w) => '<tr><td class="id">' + w.instanceId + '</td><td class="id">' + w.templateId + '</td>'
          + '<td>' + esc(weaponName(w.templateId)) + '</td>'
          + '<td><button class="btn-danger btn-sm" onclick="weaponRemove(' + w.instanceId + ')">移除</button></td></tr>').join('')
      + '</tbody>';

  $('fashionTable').innerHTML = fs.length === 0
    ? '<tbody><tr><td class="empty">衣橱为空</td></tr></tbody>'
    : '<thead><tr><th>时装 ID</th><th>名称</th><th style="width:120px">操作</th></tr></thead><tbody>'
      + fs.map((f) => '<tr><td class="id">' + f + '</td><td>' + esc(fashionName(f)) + '</td>'
          + '<td><button class="btn-danger btn-sm" onclick="fashionRemove(' + f + ')">移除</button></td></tr>').join('')
      + '</tbody>';

  // 任务容器由 loadStory() 渲染（读服务端真实容器，不用面板镜像）
}

/* ============================ 刷新 ============================ */
let refreshing = false;
async function refreshAll() {
  if (refreshing) return;
  refreshing = true;
  try {
    try { state.status = await api('/api/status'); } catch (e) { state.status = null; }
    try { state.content = await api('/api/content'); } catch (e) { state.content = null; }
    renderStatus();
    renderContent();
  } finally { refreshing = false; }
}

async function boot() {
  log('控制台已启动，正在加载字典…');
  await loadDict('characters');
  await loadDict('meta');

  if (state.dictMeta && state.dictMeta.counts) {
    const c = state.dictMeta.counts;
    $('ovDict').textContent = '角色 ' + (c.characters || 0) + ' · 武器 ' + (c.weapons || 0) + ' · 时装 ' + (c.fashions || 0)
      + ' · 载具 ' + (c.vehicles || 0) + ' · 物品 ' + (c.items || 0) + ' · 任务 ' + (c.tasks || 0)
      + ' · 章节 ' + (c.chapters || 0) + ' · 商城 ' + (c.mall || 0);
  } else {
    $('ovDict').textContent = '字典未生成。请在项目根目录运行：python tools_build_catalog.py';
  }

  $('weaponSpirit').innerHTML = '<option value="0">自动（首个角色）</option>'
    + (state.dict.characters || []).map((c) => '<option value="' + c.id + '">' + esc(label(c.zh, c.en)) + ' — ' + c.id + '</option>').join('');

  await loadFleet();
  for (const k of ['weapons', 'fashions', 'items', 'tasks', 'vehicles', 'vehicleTypes', 'chapters', 'mall']) {
    await loadDict(k);
  }
  renderItemOptions(); renderWeaponOptions(); renderFashionOptions(); renderDict();

  await refreshAccounts();

  // 主线剧情链 + 敌人生成目录（服务端没起来时静默失败）
  $('enemySelect').addEventListener('change', onEnemyPick);
  $('agentSelect').addEventListener('change', onAgentPick);
  $('agentMonsters').addEventListener('change', loadAgents);
  await loadStory();
  await loadTaskSearch();
  await loadEnemyGroups();
  await loadAgents();
  await loadStreetNpcs();

  // 任务容器是服务端状态，跟着刷新走
  setInterval(loadStory, 5000);

  await refreshAll();
  setInterval(refreshAll, 2000);
  // 基线单项重发的按钮清单（只加载一次）
  await loadBaselineSteps();
  // 天气按钮清单（只加载一次）
  await loadWeatherOptions();
  // 剧情演出列表（只加载一次）
  await loadCutscenes();
  await loadDialogs();
  // 切人动画（SwitchSpiritConfig 换人传送）
  await loadTimelines();
  // 过场播片（TimelineConfig 电影式实时演算）
  await loadCinematics();
  log('就绪');
}

boot();
</script>
</body>
</html>
