      "meditation_text": "星河影落万山幽",
      "__IDX__meditation_text": 170829,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 3,
      "meditation_text": "人生百岁如弹指",
      "__IDX__meditation_text": 170840,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 4,
      "meditation_text": "一醉扶摇九万秋",
      "__IDX__meditation_text": 170851,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 5,
      "meditation_text": "长风万里啸清秋",
      "__IDX__meditation_text": 170862,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 6,
      "meditation_text": "苍茫天地一杯收",
      "__IDX__meditation_text": 170870,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 7,
      "meditation_text": "浮世悠悠同逝水",
      "__IDX__meditation_text": 170871,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 8,
      "meditation_text": "且向杯中寄远游",
      "__IDX__meditation_text": 170872,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 9,
      "meditation_text": "濯手寒溪月正明",
      "__IDX__meditation_text": 170873,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 10,
      "meditation_text": "十指犹沾药气轻",
      "__IDX__meditation_text": 170819,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 11,
      "meditation_text": "年深每觉来人少",
      "__IDX__meditation_text": 170820,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 12,
      "meditation_text": "且共白云终此行",
      "__IDX__meditation_text": 170821,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 13,
      "meditation_text": "松风入座涤乱形",
      "__IDX__meditation_text": 170822,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 14,
      "meditation_text": "指过千肩脉自平",
      "__IDX__meditation_text": 170823,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 15,
      "meditation_text": "俯仰之间人已换",
      "__IDX__meditation_text": 170824,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 16,
      "meditation_text": "溪山不改旧时清",
      "__IDX__meditation_text": 170825,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 17,
      "meditation_text": "歇杵堂前月正圆",
      "__IDX__meditation_text": 170826,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 18,
      "meditation_text": "千锤只为一丸鲜",
      "__IDX__meditation_text": 170827,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 19,
      "meditation_text": "人笑案头无长进",
      "__IDX__meditation_text": 170828,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 20,
      "meditation_text": "疲时自有月来怜",
      "__IDX__meditation_text": 170830,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 21,
      "meditation_text": "潮声入巷点炊烟",
      "__IDX__meditation_text": 170831,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 22,
      "meditation_text": "此臂无名肩自坚",
      "__IDX__meditation_text": 170832,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 23,
      "meditation_text": "不问前程问火候",
      "__IDX__meditation_text": 170833,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 24,
      "meditation_text": "明朝犹向旧砧前",
      "__IDX__meditation_text": 170834,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 25,
      "meditation_text": "竹横墙角晚风凉",
      "__IDX__meditation_text": 170835,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 26,
      "meditation_text": "徐挥如水不曾忙",
      "__IDX__meditation_text": 170836,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 27,
      "meditation_text": "街坊只道痴顽老",
      "__IDX__meditation_text": 170837,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 28,
      "meditation_text": "笑拈残叶入斜阳",
      "__IDX__meditation_text": 170838,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 29,
      "meditation_text": "扫罢寒街星始藏",
      "__IDX__meditation_text": 170839,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 30,
      "meditation_text": "叶经帚底自成行",
      "__IDX__meditation_text": 170841,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 31,
      "meditation_text": "尘定风收人散后",
      "__IDX__meditation_text": 170842,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 32,
      "meditation_text": "倚帚闲看日渐长",
      "__IDX__meditation_text": 170843,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 33,
      "meditation_text": "小女随鹅傍水鸣",
      "__IDX__meditation_text": 170844,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 34,
      "meditation_text": "年来逐鸟遍山青",
      "__IDX__meditation_text": 170845,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 35,
      "meditation_text": "临窗笑仿猫儿洗",
      "__IDX__meditation_text": 170846,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 36,
      "meditation_text": "不觉形拳已自灵",
      "__IDX__meditation_text": 170847,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 37,
      "meditation_text": "独卧荒林草未惊",
      "__IDX__meditation_text": 170848,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 38,
      "meditation_text": "涉溪持镜忘浮名",
      "__IDX__meditation_text": 170849,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 39,
      "meditation_text": "无心避石身如燕",
      "__IDX__meditation_text": 170850,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 40,
      "meditation_text": "百兽为师技自精",
      "__IDX__meditation_text": 170852,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 41,
      "meditation_text": "云手轻描月色中",
      "__IDX__meditation_text": 170853,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 42,
      "meditation_text": "卷舒开合意无穷",
      "__IDX__meditation_text": 170854,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 43,
      "meditation_text": "人道冰霜难可近",
      "__IDX__meditation_text": 170855,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 44,
      "meditation_text": "冷面何妨一笑松",
      "__IDX__meditation_text": 170856,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 45,
      "meditation_text": "临流缓吐夜来风",
      "__IDX__meditation_text": 170857,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 46,
      "meditation_text": "敛尽锋芒劲暗融",
      "__IDX__meditation_text": 170858,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 47,
      "meditation_text": "相看但觉凛如雪",
      "__IDX__meditation_text": 170859,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 48,
      "meditation_text": "铁腕柔肠本自同",
      "__IDX__meditation_text": 170860,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 49,
      "meditation_text": "一脉分来百派流",
      "__IDX__meditation_text": 170861,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 50,
      "meditation_text": "或刚或逸各千秋",
      "__IDX__meditation_text": 170863,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 51,
      "meditation_text": "功随代改形难定",
      "__IDX__meditation_text": 170864,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 52,
      "meditation_text": "走转悠悠尚未休",
      "__IDX__meditation_text": 170865,
      "__RAW__meditation_text": ""
    },
    {
      "Id": 53,
      "meditation_text": "步踏玄机月复周",
      "__IDX__meditation_text": 170866,
      "__RAW__meditation_text": ""
    },
    {
