  "records": [
    {
      "Id": 12009500,
      "ClueDes": "网恋认识，最开始扮演“完美男友”，迅速成为你孤独世界中最懂你的“灵魂伴侣”。",
      "ClueHint": "网络上的完美恋人",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009501,
      "ClueDes": "不断以家人重病、工作周转等事情为由求助，并辅以伪造的证据，让你难以拒绝。",
      "ClueHint": "一次次困难，一次次请求",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009502,
      "ClueDes": "不断拒绝视频或见面核实得请求，并因你的“不信任”而被情感操控，心生愧疚。",
      "ClueHint": "从未见过的“爱人”",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009503,
      "ClueDes": "不断想你索要钱财，甚至让你借贷给他。你不惜去网贷，甚至抵押了房产。",
      "ClueHint": "背负经济重担，落入最终陷阱",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009504,
      "ClueDes": "“创生科技”以双倍薪资和公司公寓等优厚条件，邀请你入职推销“天才小药丸”。",
      "ClueHint": "条件俱佳的新工作",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009506,
      "ClueDes": "该药丸“能安全提升智商”的作用让人怀疑，缺乏权威认证，争议巨大。",
      "ClueHint": "​完美产品的疑点",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009507,
      "ClueDes": "HR对关键问题语焉不详且不断催促，这与你知道的推销话术陷阱如出一辙。",
      "ClueHint": "不断催促的入职邀约",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009508,
      "ClueDes": "辛苦工作五年后获得重要的升职机会，但需要常驻外地。",
      "ClueHint": "五年耕耘的晋升机会",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009509,
      "ClueDes": "与男友相识三年已谈婚论嫁，但对方强烈反对异地，并希望尽快结婚生子。",
      "ClueHint": "三年感情与婚约计划",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009510,
      "ClueDes": "因此事与男友不断争吵，对方认为选择事业是对感情的轻视，关系陷入僵局。",
      "ClueHint": "男友的观点",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009512,
      "ClueDes": "训练中力不从心，运动表现显著下降，这是过度训练的典型核心症状。",
      "ClueHint": "持续的疲惫与酸痛",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009513,
      "ClueDes": "教练注意到你的持续低迷提议转回学习，打击了你的自信心。",
      "ClueHint": "教练的谈话",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009514,
      "ClueDes": "",
      "ClueHint": "自己的梦想",
      "Milestones": [],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009520,
      "ClueDes": "她厌倦反复听人倾诉，觉得自己像情绪垃圾桶，也看见了新启的黑暗。",
      "ClueHint": "为什么不想做占卜师？",
      "Milestones": [
        12010000,
        12010001,
        12010002
      ],
      "ClueDanmuEventId": 38
    },
    {
      "Id": 12009521,
      "ClueDes": "人们在占卜桌前很少撒谎，她因此积累了大量比金钱更有价值的秘密。",
      "ClueHint": "现在还在做占卜师的原因",
      "Milestones": [
        12010003,
        12010004,
        12010005
      ],
      "ClueDanmuEventId": 39
    },
    {
      "Id": 12009522,
      "ClueDes": "她把分店视作节点、把顾客视作牌，正在连接覆盖新启的秘密网络，而且计划很缺人。",
      "ClueHint": "真正想做的事是？",
      "Milestones": [
        12010006,
        12010007,
        12010008
      ],
      "ClueDanmuEventId": 40
    },
    {
      "Id": 12009524,
      "ClueDes": "她要掌握并释放全城秘密，让该曝光的曝光、该倒台的倒台，令新启变得更好。",
      "ClueHint": "大事是指？",
      "Milestones": [
        12010009,
        12010010,
        12010011
      ],
      "ClueDanmuEventId": 42
    },
    {
      "Id": 12009525,
      "ClueDes": "游戏群认识，天天早安晚安送热粥。「好到觉得不真实。」",
      "ClueHint": "你们感情怎么样",
      "Milestones": [],
      "ClueDanmuEventId": 44
    },
    {
      "Id": 12009526,
      "ClueDes": "他借钱越来越多，妈妈住院、工地事故，她借了网贷。他只还过零头。",
      "ClueHint": "哪里觉得不真实",
      "Milestones": [],
      "ClueDanmuEventId": 45
    },
    {
      "Id": 12009527,
      "ClueDes": "从没见面没视频过。她追问，他冷战两天，最后她道歉了。",
      "ClueHint": "你们见过面吗",
      "Milestones": [],
      "ClueDanmuEventId": 46
    },
    {
      "Id": 12009528,
      "ClueDes": "消息越来越少，最后一次是让她抵押房子。手机全是催收。",
      "ClueHint": "最近是否还有联系",
      "Milestones": [],
      "ClueDanmuEventId": 47
    },
    {
      "Id": 12009529,
      "ClueDes": "双倍底薪、精装公寓。「每条都是我缺的，他们咋知道？」",
      "ClueHint": "工作的福利",
      "Milestones": [],
      "ClueDanmuEventId": 49
    },
    {
      "Id": 12009530,
      "ClueDes": "还是做推销，卖「天才小药丸」。他查过，没有独立认证。",
      "ClueHint": "工作的内容",
      "Milestones": [],
      "ClueDanmuEventId": 50
    },
    {
      "Id": 12009531,
      "ClueDes": "他说HR的催促方式跟自己推销话术一样。「我被自己的套路套了。」",
      "ClueHint": "你自己怎么看",
      "Milestones": [],
      "ClueDanmuEventId": 51
    },
    {
      "Id": 12009532,
      "ClueDes": "他规划儿子一路变坏，最终进入帮派。",
      "ClueHint": "什么是正道？",
      "Milestones": [
        12010012,
        12010013
      ],
      "ClueDanmuEventId": 54
    },
    {
      "Id": 12009533,
      "ClueDes": "儿子成绩优秀、热心公益，他嘴上抱怨却暗自骄傲。",
      "ClueHint": "儿子的现状",
      "Milestones": [
        12010014,
        12010015,
        12010016
      ],
      "ClueDanmuEventId": 55
    },
    {
      "Id": 12009534,
      "ClueDes": "游戏、漫画和零食都没让儿子放弃学习，他也知道管不了。",
      "ClueHint": "试过什么办法",
      "Milestones": [
        12010017,
        12010018,
        12010019
      ],
      "ClueDanmuEventId": 56
    },
    {
      "Id": 12009535,
      "ClueDes": "儿子想去启明学院学习，以后留下执教。",
      "ClueHint": "以后打算怎么办",
      "Milestones": [
        12010020,
        12010021
      ],
      "ClueDanmuEventId": 57
    },
    {
      "Id": 12009536,
      "ClueDes": "猫陪伴了自己很久，并且猫不会嫌弃自己。三套房四个子女，最大的留给橘猫。",
      "ClueHint": "为什么要给猫",
      "Milestones": [],
      "ClueDanmuEventId": 59
    },
    {
      "Id": 12009537,
      "ClueDes": "大儿子骂糊涂、二女儿哭、老三找律师。老四二十年没回来。",
      "ClueHint": "子女们的态度",
      "Milestones": [],
      "ClueDanmuEventId": 60
    },
    {
      "Id": 12009538,
      "ClueDes": "法律系学生帮拟了宠物信托。子女申请限制行为能力被法院驳回。",
      "ClueHint": "法律咨询",
      "Milestones": [],
      "ClueDanmuEventId": 61
    },
    {
      "Id": 12009539,
      "ClueDes": "法律赢了但她不开心。「如果我赢了，算不算坏妈妈？」",
      "ClueHint": "心里的顾虑",
      "Milestones": [],
      "ClueDanmuEventId": 62
    },
    {
      "Id": 12009540,
      "ClueDes": "提前一个月布置场地买蛋糕。等了三小时一个人没来。",
      "ClueHint": "发生什么事了",
      "Milestones": [],
      "ClueDanmuEventId": 64
    },
    {
      "Id": 12009541,
      "ClueDes": "社交平台发的私信邀请。\"每条都发了，他们平时都回我的。\"",
      "ClueHint": "你是怎么邀请你朋友的",
      "Milestones": [],
      "ClueDanmuEventId": 65
    },
    {
      "Id": 12009542,
      "ClueDes": "翻遍聊天记录，没一条对方叫过她名字。她不说话了。",
      "ClueHint": "他们知道你的名字吗",
      "Milestones": [],
      "ClueDanmuEventId": 66
    },
    {
      "Id": 12009543,
      "ClueDes": "背老奶奶过马路，她在找狗，狗在对面。视频上了热搜。",
      "ClueHint": "询问事情详细经过",
      "Milestones": [],
      "ClueDanmuEventId": 69
    },
    {
      "Id": 12009544,
      "ClueDes": "帮同事注册三个相亲APP，约同天同地。同事被叫「扑克男」。",
      "ClueHint": "还有呢？",
      "Milestones": [],
      "ClueDanmuEventId": 70
    },
    {
      "Id": 12009545,
      "ClueDes": "写了自动批假脚本，老板的假弹在了董事会投影仪上。",
      "ClueHint": "还有呢？？",
      "Milestones": [],
      "ClueDanmuEventId": 71
    },
    {
      "Id": 12009546,
      "ClueDes": "没一个人说过谢谢。他觉得很冒。「是不是命里犯小人？」",
      "ClueHint": "他们都什么态度",
      "Milestones": [],
      "ClueDanmuEventId": 72
    },
    {
      "Id": 12009547,
      "ClueDes": "三年前他从那家公司离职,自己走的。\"没人赶我,也没人留我。我自己收拾了东西。\"",
      "ClueHint": "他上一份工作什么时候离的",
      "Milestones": [],
      "ClueDanmuEventId": 73
    },
    {
      "Id": 12009548,
      "ClueDes": "他每天早八点在前公司８87人群里发\"早\",三年没人回过他,也没人踢他出群。",
      "ClueHint": "那个公司群还在吗",
      "Milestones": [],
      "ClueDanmuEventId": 74
    },
    {
      "Id": 12009549,
      "ClueDes": "上个月公司倒闭,老板发\"此群解散\"。他还是发了第1098个\"早\",手指自己打的。",
      "ClueHint": "那家公司现在还在吗",
      "Milestones": [],
      "ClueDanmuEventId": 75
    },
    {
      "Id": 12009550,
      "ClueDes": "报出一长串明星、大V和博主。\"我们互关的，是朋友。\"",
      "ClueHint": "你邀请的都是哪些朋友",
      "Milestones": [],
      "ClueDanmuEventId": 76
    },
    {
      "Id": 12009551,
      "ClueDes": "公司年会给他报了钢琴才艺，他吓得手抖。",
      "ClueHint": "“槛”是指？",
      "Milestones": [
        12010022,
        12010023
      ],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009552,
      "ClueDes": "三年前简历写钢琴十级，实际刚学单手《小星星》。",
      "ClueHint": "出什么问题了？",
      "Milestones": [
        12010024,
        12010025,
        12010026
      ],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009553,
      "ClueDes": "他报了速成班，白天上班晚上练琴，还谎称在练打字。",
      "ClueHint": "打算怎么应付？",
      "Milestones": [
        12010027,
        12010028,
        12010029
      ],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009554,
      "ClueDes": "老板安排他与音乐学院研究生四手联弹，无法轻易退出。",
      "ClueHint": "能不上吗？",
      "Milestones": [
        12010030,
        12010031,
        12010032
      ],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009555,
      "ClueDes": "本地美食节目要来她家拍摄做菜。",
      "ClueHint": "上什么节目？",
      "Milestones": [
        12010033,
        12010034
      ],
      "ClueDanmuEventId": 0
    },
    {
      "Id": 12009556,
      "ClueDes": "精致菜照大多是外卖重新摆盘。",
      "ClueHint": "朋友圈发的是什么？",
      "Milestones": [
        12010035,
